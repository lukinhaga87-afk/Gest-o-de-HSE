# GEMINI_API_KEY: Opcional / necessário caso utilize recursos de IA no backend.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL pública oficial da aplicação no Netlify (ex: https://seu-site.netlify.app)
APP_URL="https://seu-site.netlify.app"

# API_AUTH_SECRET: Chave secreta forte OBRIGATÓRIA (mínimo 32 caracteres aleatórios) para assinar tokens HMAC-SHA256
# Gere com: openssl rand -base64 36  (Configure exclusivamente no painel do Netlify / ambiente do servidor)
API_AUTH_SECRET=""

# INITIAL_ADMIN_PASSWORD: Opcional para ativação inicial única do Administrador Mestre (mínimo 10 caracteres, sem senhas padrão)
# Após o primeiro login com troca concluída no Firestore, pode ser removida das variáveis de ambiente.
INITIAL_ADMIN_PASSWORD=""

# SERVIÇO REAL DE E-MAIL (SMTP) PARA NOTIFICAÇÕES AUTOMÁTICAS E DISPAROS
# Configure exclusivamente nas Environment Variables protegidas do painel Netlify
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="seu-email-notificacoes@dominio.com"
SMTP_PASS="sua-senha-de-app-smtp"
SMTP_FROM="Gestão SST <seu-email-notificacoes@dominio.com>"
SMTP_SECURE="false"

# RECUPERAÇÃO DE SENHA VIA WHATSAPP OU SMS (OPCIONAL - OPÇÃO B)
# Caso não estejam configuradas, o sistema não simula envios e utiliza o fluxo via Administrador de EHS (Opção A).
WHATSAPP_API_URL=""
WHATSAPP_API_TOKEN=""
SMS_WEBHOOK_URL=""
SMS_API_TOKEN=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM=""
TWILIO_SMS_FROM=""

# FIREBASE ADMIN SDK (EXCLUSIVO SERVER-SIDE — NUNCA EXPOR COM PREFIXO VITE_)
# Opção 1 (recomendada para Netlify): JSON completo da conta de serviço (ou codificado em Base64)
FIREBASE_SERVICE_ACCOUNT_JSON=""
# Opção 2: Campos individuais da conta de serviço
FIREBASE_ADMIN_PROJECT_ID=""
FIREBASE_ADMIN_CLIENT_EMAIL=""
FIREBASE_ADMIN_PRIVATE_KEY=""
# Opcional: sobrescrever o ID da base Firestore (padrão: firebase-applet-config.json)
FIREBASE_FIRESTORE_DATABASE_ID=""
# Opcional: defina "true" em produção após configurar credenciais para bloquear fallback para Web SDK
FIREBASE_REQUIRE_ADMIN_SDK="false"
# Opcional: defina "true" apenas em ambientes GCP com Workload Identity / ADC configurado
FIREBASE_USE_ADC="false"

# OBJECT STORAGE PRIVADO PARA DOCUMENTOS DA CENTRAL DE INTEGRAÇÃO (SERVERLESS / NETLIFY)
# Valores aceitos: firebase_storage | gcs | azure_blob | local_private (local_private falha fechado em serverless)
INTEGRATION_STORAGE_PROVIDER=""
# Para Firebase Storage ou Google Cloud Storage privado (via Firebase Admin SDK)
FIREBASE_STORAGE_BUCKET=""
GCS_BUCKET_NAME=""
# Para Azure Blob Storage privado (container sem acesso público)
AZURE_STORAGE_ACCOUNT_NAME=""
AZURE_STORAGE_ACCOUNT_KEY=""
AZURE_STORAGE_CONTAINER_NAME=""
# Tempo de vida (segundos) de tickets temporários assinados para leitura autenticada (padrão: 60, máx: 300)
INTEGRATION_FILE_SIGNING_TTL_SECONDS="60"
