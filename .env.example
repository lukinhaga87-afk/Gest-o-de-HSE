# GEMINI_API_KEY: Opcional / necessário caso utilize recursos de IA no backend.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL pública oficial da aplicação no Netlify (ex: https://seu-site.netlify.app)
APP_URL="https://seu-site.netlify.app"

# API_AUTH_SECRET: Chave secreta forte OBRIGATÓRIA (mínimo 32 caracteres aleatórios) para assinar tokens HMAC-SHA256
# Gere com: openssl rand -base64 36  (Configure exclusivamente no painel do Netlify / ambiente do servidor)
API_AUTH_SECRET=""

# INITIAL_ADMIN_PASSWORD: Opcional para ativação inicial única do Administrador Mestre (mínimo 10 caracteres, sem senhas padrão)
# Após o primeiro login com troca concluída no Firestore, pode ser removida das variáveis de ambiente.
INITIAL_ADMIN_PASSWORD=""

# SERVIÇO REAL DE E-MAIL (SMTP) PARA NOTIFICAÇÕES AUTOMÁTICAS E DISPAROS
# Configure exclusivamente nas Environment Variables protegidas do painel Netlify
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="seu-email-notificacoes@dominio.com"
SMTP_PASS="sua-senha-de-app-smtp"
SMTP_FROM="Gestão SST <seu-email-notificacoes@dominio.com>"
SMTP_SECURE="false"
