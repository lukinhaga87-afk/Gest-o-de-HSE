# GEMINI_API_KEY: Opcional / necessário caso utilize recursos de IA no backend.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL pública oficial da aplicação no Netlify (ex: https://seu-site.netlify.app)
APP_URL="https://seu-site.netlify.app"

# API_AUTH_SECRET: Chave secreta forte (mínimo 32 caracteres) usada para assinar tokens HMAC-SHA256 das rotas protegidas
API_AUTH_SECRET="CONFIGURE_A_STRONG_RANDOM_SECRET_IN_NETLIFY"

# SERVIÇO REAL DE E-MAIL (SMTP) PARA NOTIFICAÇÕES AUTOMÁTICAS E DISPAROS
# Configure exclusivamente nas Environment Variables protegidas do painel Netlify
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="seu-email-notificacoes@dominio.com"
SMTP_PASS="sua-senha-de-app-smtp"
SMTP_FROM="Gestão SST <seu-email-notificacoes@dominio.com>"
SMTP_SECURE="false"
